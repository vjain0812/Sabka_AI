# Guest onboarding and the dated research snapshot work without credentials.
# Never prefix these with NEXT_PUBLIC_. Keep real values in ignored .env.local.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Used ONLY by operator scripts, not by the running application.
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are also supported.
TAVILY_API_KEY=
# Optional alternative search adapter:
BRAVE_SEARCH_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional alternative extraction provider (requires explicit model):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Recommendation re-ranking (optional). Uses OPENROUTER_API_KEY first, then GROQ_API_KEY.
# Without either key, recommendations are ranked by deterministic rules only.
OPENROUTER_RANKING_MODEL=anthropic/claude-haiku-5.5
GROQ_RANKING_MODEL=openai/gpt-oss-120b
# Safety cap on model calls per server per day; extra requests fall back to rules.
RECOMMENDER_AI_DAILY_LIMIT=2000
# Administrator membership is stored in catalog_admins, never in browser flags.
# Connect preview store path (development only; used until the Connect migration is applied).
CONNECT_DEV_STORE=
# Development only: where My AI Journey keeps data until its migration is applied.
JOURNEY_DEV_STORE=
