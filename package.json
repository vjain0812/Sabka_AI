{
  "name": "sabka-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:check": "tsx scripts/validate-seeds.ts",
    "catalog:check": "node --conditions=react-server --import tsx scripts/import-catalog.mts",
    "catalog:import": "node --conditions=react-server --env-file=.env.local --import tsx scripts/import-catalog.mts --apply",
    "services:check": "node scripts/check-services.mjs",
    "secrets:check": "node scripts/check-client-secrets.mjs",
    "setup": "npm ci && npm run seed:check",
    "format": "prettier --write src tests scripts *.ts *.mts *.mjs package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts *.ts *.mts *.mjs package.json tsconfig.json",
    "logos:fetch": "node --conditions=react-server --import tsx scripts/fetch-logos.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
